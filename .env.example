# Pfad zur SQLite-Datei (Standard: ./data/abo-pilot.db)
ABO_DB_PATH=./data/abo-pilot.db
# Nur fuer lokale Tests mit `next start` ueber http auf false setzen
COOKIE_SECURE=
# Team-Zugang zur Angebotspflege (kommagetrennt)
ADMIN_EMAILS=
# Geheimnis für den täglichen Suchlauf (mind. 16 Zeichen)
CRON_SECRET=
# Für die KI-Extraktion von Tarifseiten ohne strukturierte Daten
ANTHROPIC_API_KEY=
# Digitale Kündigung (leer = Testbetrieb ohne Aussenwirkung)
APP_URL=https://abo-pilot.ch
SIGN_PROVIDER=          # skribble
SKRIBBLE_USERNAME=
SKRIBBLE_API_KEY=
MAIL_PROVIDER=          # smtp
SMTP_URL=               # z. B. smtps://user:pass@mail.infomaniak.com:465
MAIL_FROM=Abo-Pilot <kuendigung@abo-pilot.ch>
POST_PROVIDER=          # pingen
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANISATION_ID=
PINGEN_REGISTERED_PRODUCT=registered
